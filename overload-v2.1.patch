+        self.project_btn.clicked.connect(lambda: on_prepare(item.path))
+        actions.addWidget(self.project_btn)
+
+        self.tracks_btn = IconButton(
+            "subtitles",
+            "Gérer ou extraire les sous-titres et pistes audio",
