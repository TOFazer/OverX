+
+        self.thumb = Thumbnail(palette, width=round(68 * scale), height=round(48 * scale))
+        self.thumb.set_source(item.path.name, item.path)
+        layout.addWidget(self.thumb, 0, Qt.AlignmentFlag.AlignVCenter)
