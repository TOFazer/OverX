+        self.setObjectName("guideCard")
+        self._palette = palette
+        layout = QVBoxLayout(self)
+        layout.setContentsMargins(18, 15, 18, 15)
+        layout.setSpacing(10)
+
+        head = QHBoxLayout()
+        head.setSpacing(10)
+        self.badge = GlyphBadge(
+            "compass",
