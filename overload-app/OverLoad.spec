# -*- mode: python ; coding: utf-8 -*-
"""Spécification PyInstaller directe : `pyinstaller OverLoad.spec` -> `dist/OverLoad.exe`."""

from pathlib import Path

from PyInstaller.utils.hooks import collect_submodules

