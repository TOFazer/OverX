if (ROOT / "tools").is_dir():
    _DATAS.append((str(ROOT / "tools"), "tools"))

a = Analysis(
    [str(ROOT / "src" / "overload" / "exe_entry.py")],
    pathex=[str(ROOT / "src")],
    binaries=[],
    datas=_DATAS,
    hiddenimports=[
        "overload",
        "overload.core",
    "overload.core.diagnostics",
        "overload.core.errors",
        "overload.core.formatting",
        "overload.core.paths",
        "overload.creators",
